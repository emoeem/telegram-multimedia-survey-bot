{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "routes": [
    {
      "src": "/api/submit$",
      "dest": "https://submission-bot.3353745917.workers.dev/api/submit",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-relay-token"
          },
          "args": "$RELAY_SECRET_BOT",
          "env": [
            "RELAY_SECRET_BOT"
          ]
        },
        {
          "type": "request.headers",
          "op": "delete",
          "target": {
            "key": "x-relay-country"
          }
        }
      ]
    },
    {
      "src": "/api/submit/(.*)",
      "dest": "https://submission-bot.3353745917.workers.dev/api/submit/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-relay-token"
          },
          "args": "$RELAY_SECRET_BOT",
          "env": [
            "RELAY_SECRET_BOT"
          ]
        },
        {
          "type": "request.headers",
          "op": "delete",
          "target": {
            "key": "x-relay-country"
          }
        }
      ]
    },
    {
      "src": "/(.*)",
      "dest": "https://emoe.eu.cc/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-relay-token"
          },
          "args": "$RELAY_SECRET",
          "env": [
            "RELAY_SECRET"
          ]
        },
        {
          "type": "request.headers",
          "op": "delete",
          "target": {
            "key": "x-relay-country"
          }
        }
      ]
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
