scripts/galgame/.se-cache/
scripts/galgame/.se-raw/
# QA 运行产物（截图、页面转储、几何数据）
qa/artifacts/
# 交付目录中的递归副本（误拷贝，不纳入版本库；delivery 其余内容已被跟踪）
delivery/*/delivery/

# 本地工作产物（截图、一次性验收脚本、临时数据），不进版本库
.workbuddy/

# 数据备份快照：含真实业务数据的导出（如 D1 行级备份），体积小但绝不能进版本库，
# 一旦推送就是一次不可撤回的用户数据泄露。
.backup/

# 本地计划/草稿产物
.zcode/

# Mimosa 的 hook 状态目录（每次会话都会变，34MB，1657 个文件，属于运行时产物）
.mimosa/

# 多代理评审的中间产物（after-A … after-final），属于临时工作目录
_review/

# survey-tool 的编译产物（三平台各 ~90MB，用 pnpm build:tool 重新生成）
tools/survey-tool/dist/
