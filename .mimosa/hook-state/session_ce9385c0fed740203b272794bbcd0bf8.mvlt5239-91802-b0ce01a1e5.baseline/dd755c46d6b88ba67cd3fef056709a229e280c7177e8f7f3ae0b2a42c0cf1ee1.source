# -*- coding: utf-8 -*-
"""扩写：路线四 · 隔着一座城说晚安（第 9–20 节）。

基调是"最远的开场"：不见面、不交换身份，全靠文字与呼吸的节奏。
第 14 节的「靠近」与第 17 节的「失联」是本线的情绪双峰。
"""

PROSE = {
    "n-d1": (
        "你选了最远的一种开场。她像是笑了——你听得出来，文字里的那种笑，尾巴收得很轻。\n\n"
        "「好。那就立个规矩：不问真名，不看照片，不发定位。今晚我们只交换文字，隔着一座城。」\n\n"
        "「十一公里。」她补了一句，「我查过，从台里到你那栋楼，十一公里。这个距离刚刚好——"
        "够我说话，不够我看你。」\n\n"
        "你说好。窗外的雨小了一点，玻璃上的水痕把楼下的路灯拉成一根很长的竖线，"
        "你看了那根线很久。"
    ),
    "q-d2": (
        "她问得很随意，像随手翻过一页。但你注意到她把「凌晨」两个字放在了句子中间——"
        "不是「为什么听电台」，是「为什么在那个时间」。\n\n"
        "屏幕右上角是 02:31。你把答案在脑子里过了一遍，发现这个问题你从来没对任何人"
        "说过完整版：一半是习惯，一半是怕。\n\n"
        "你说——"
    ),
    "n-d3": (
        "她念了一段只有你能听懂的话。\n\n"
        "「推理小说里最好用的东西不是凶器，是不在场证明。」她说，「两个人隔着距离互道晚安，"
        "就是彼此最温柔的不在场证明——那一整个晚上，谁都没法证明你不孤独，"
        "也没法证明她不是你唯一在等的人。」\n\n"
        "你笑了一下，笑到一半停住。\n\n"
        "然后你们开始一条一条地写。她的标点很省，省下来的地方全是呼吸："
        "逗号是换气，句号是「我说完了」，"
        "而那些她连标点都不给的地方——你只能自己听着读。"
    ),
    "q-d4": (
        "她发来一句：「今晚的雨，是哪个声部？」\n\n"
        "你抬起头。雨落在铁皮雨棚上、落在别人的伞上、落在空调外机的壳上，"
        "确实不是同一种声音。这个问题听着像玩笑，其实是她在问你："
        "你今晚听见的世界，是哪一层。\n\n"
        "你回——"
    ),
    "n-d5": (
        "于是「晚安」被拆成了一句一句。\n\n"
        "「你现在靠在哪？」「床头。」「台灯关了没有？」「没关。」\n\n"
        "「那就好。我想看着你把这条读完。」\n\n"
        "你低头，发现自己的拇指停在屏幕上，没有打字。窗外十一公里之外，"
        "大概有另一个人也正用同样的姿势停在半空。\n\n"
        "没有越界。可是有什么东西已经不一样了——隔着十一公里，你们同时失眠，"
        "又同时心安。"
    ),
    "q-d6": (
        "她问：「今晚，你想到这里，还是……让我再靠近一点点？」\n\n"
        "「隔着文字的那种靠近。」她先补了一句，把话钉稳，「我会先问，你随时可以说停。」\n\n"
        "屏幕上那行字晾在那里，谁都没有催。两个说停的权利，一人一个——"
        "谁用都算数，用完不算欠。\n\n"
        "你回——"
    ),
    "n-d7": (
        "「晚安」之外，你们开始交换呼吸的节奏。\n\n"
        "她说她的声音贴着话筒，像有人在你耳边替你把领口整理好；"
        "你说你的指尖悬在屏幕上，悬了很久，落下去的时候轻得像怕吵醒谁。\n\n"
        "你们都没有说任何一个越界的字。可有些词被你们同时打出来，又同时删掉——"
        "屏幕在那一秒里亮一下，暗一下，"
        "像两个人隔着一座城同时开了灯又同时关上。\n\n"
        "删掉的字，也算数。"
    ),
    "q-d8": (
        "天边开始发灰的时候，你意识到这一夜要说完了。\n\n"
        "她那边没有催，输入框上方的「对方正在输入」亮起又灭了三次。"
        "黎明前最后一条消息，写什么，这一夜的重量就落在什么上面。\n\n"
        "你会怎么写——"
    ),
    "n-d9": (
        "雨季结束的那个星期，02:14 没有亮。\n\n"
        "节目还在，声音还在，只是换了一个陌生的代班主播，念得字正腔圆，"
        "一处留白也没有——每一次停顿都落在标点上，像有人拿尺子量过。\n\n"
        "你盯着收音机的红灯，等到两点四十分，像在等一个已经不会来的末班车。\n\n"
        "导播的自动回复说：晚棠老师嗓音不适。\n\n"
        "你知道不是。你翻出这半个月攒下的暗号和考题，第一次发现它们不是甜——是证据："
        "证明有一个人，每天都把自己的声音递给一座城市。而现在，递声音的人有麻烦了。"
    ),
    "q-d10": (
        "第九天，02:14 亮了。\n\n"
        "她只发了三行：「是我。三年前剪我声音的那个，找到台里地址了。"
        "这两天他在楼下站过两晚。」\n\n"
        "没有语音，没有表情，连她惯常省下的标点都在。你把手机放平，"
        "又拿起来，屏幕上的字一个也没变。\n\n"
        "你回——"
    ),
    "n-d11": (
        "天亮之前，她把你的第十二封信从信箱里取了出来，夹进她的台历。\n\n"
        "「不回信的规矩，」她在下线前说，「从今晚起改一条：只回 0417。」\n\n"
        "你看着那句话，忽然想起她在节目里说过的另外一句——"
        "「声音递出去，就收不回来。」她把声音收回去了半个月，"
        "再递出来的时候，选了一个编号当收件人。\n\n"
        "你合上手机。城市开始发白。有些关系不需要见面，"
        "也能把人从失眠里一点点捞出来。"
    ),
    "q-d12": (
        "合上这一夜。\n\n"
        "收音机的红灯还亮着，垫乐早已播完，只剩一点电流的底噪。"
        "最后一句写什么，这一夜就收在什么形状上——写给明天，写给台历，"
        "或者写给那个已经睡着的代班主播，都可以。\n\n"
        "你写——"
    ),
}
