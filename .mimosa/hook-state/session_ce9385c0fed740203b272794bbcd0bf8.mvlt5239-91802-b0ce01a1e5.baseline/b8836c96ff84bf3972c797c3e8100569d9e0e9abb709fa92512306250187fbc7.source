#!/usr/bin/env python3
"""Search OpenGameArt with license filters and list candidate content pages."""
import re, html, subprocess, sys, urllib.parse

UA = "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/131.0 Safari/537.36"
BASE = "https://opengameart.org/art-search-advanced"


def text_of(s):
    return re.sub(r"\s+", " ", html.unescape(re.sub(r"<[^>]+>", " ", s))).strip()


def search(keys, lic=None, art_type=9, pages=2):
    found = {}
    for page in range(0, pages):
        q = {"keys": keys, "field_art_type_tid[]": str(art_type), "sort_by": "count",
             "sort_order": "DESC", "page": str(page)}
        if lic:
            q["field_art_licenses_tid[]"] = str(lic)
        url = BASE + "?" + urllib.parse.urlencode(q)
        t = subprocess.run(["curl", "-sL", "-A", UA, url], capture_output=True, text=True, timeout=60).stdout
        for m in re.finditer(r'<a href="(/content/[^"]+)"[^>]*>([^<]{2,90})</a>', t):
            href, title = m.group(1), text_of(m.group(2))
            if title and not title.lower().startswith(("log in", "register", "skip")):
                found[href] = title
    return found


# OGA license taxonomy tids: 2=CC0? verify empirically. Known: 17981=CC-BY 4.0? We test by fetching.
if __name__ == "__main__":
    keys = sys.argv[1]
    lic = sys.argv[2] if len(sys.argv) > 2 else None
    res = search(keys, lic)
    for k, v in sorted(res.items()):
        print(k, "|", v)
