#!/usr/bin/env bash
# deploy-cloudflare.sh — 部署到 Cloudflare Pages（直传模式）。
# 前置: node / npm；首次运行 wrangler 会打开浏览器授权。
# 用法: ./scripts/deploy/deploy-cloudflare.sh [项目名]
#   项目名可选；也可用环境变量 CF_PAGES_PROJECT 指定。
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"

PROJECT="${1:-${CF_PAGES_PROJECT:-}}"

build_site

cd "$SITE_ROOT"
require_cmd node || die "请先安装 Node.js (>=18)。"
command -v wrangler >/dev/null 2>&1 && WRANGLER_CMD="wrangler" || WRANGLER_CMD="npx --yes wrangler"

if [[ -z "$PROJECT" ]]; then
    # 尝试从已有 wrangler 配置或 git 仓库名推断
    DEFAULT="$(basename "$SITE_ROOT" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-')"
    ask "Cloudflare Pages 项目名" "${DEFAULT%-}" PROJECT
fi

info "确保 Pages 项目存在: $PROJECT"
$WRANGLER_CMD pages project create "$PROJECT" --production-branch main >/dev/null 2>&1 \
    || info "项目可能已存在，继续部署。"

info "上传构建产物到 Cloudflare Pages..."
$WRANGLER_CMD pages deploy public --project-name "$PROJECT" --branch main --commit-dirty=true

info "完成！首次部署后可在 Cloudflare 控制台查看 *.pages.dev 域名并绑定自定义域名。"
