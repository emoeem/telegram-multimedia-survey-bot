#!/usr/bin/env bash
# common.sh — 部署脚本的公共函数库，被各平台部署脚本 source 使用。
# 不要直接执行本文件。

# 站点根目录 = scripts/deploy 的上两级
DEPLOY_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SITE_ROOT="$(cd "$DEPLOY_SCRIPT_DIR/../.." && pwd)"

# ---------- 输出工具 ----------
if [[ -t 1 ]]; then
    C_GREEN='\033[0;32m'; C_YELLOW='\033[0;33m'; C_RED='\033[0;31m'; C_CYAN='\033[0;36m'; C_OFF='\033[0m'
else
    C_GREEN=''; C_YELLOW=''; C_RED=''; C_CYAN=''; C_OFF=''
fi

info()  { echo -e "${C_GREEN}[信息]${C_OFF} $*"; }
warn()  { echo -e "${C_YELLOW}[注意]${C_OFF} $*"; }
err()   { echo -e "${C_RED}[错误]${C_OFF} $*" >&2; }

die() { err "$*"; exit 1; }

# ---------- 依赖检查 ----------
require_cmd() {
    local missing=()
    for c in "$@"; do
        command -v "$c" >/dev/null 2>&1 || missing+=("$c")
    done
    if ((${#missing[@]})); then
        err "缺少命令: ${missing[*]}，请先安装后再运行。"
        return 1
    fi
}

# Node.js 版本建议 >= 18
check_node() {
    require_cmd node || return 1
    local major
    major="$(node -p 'process.versions.node.split(".")[0]')"
    if ((major < 18)); then
        warn "检测到 Node.js $(node -v)，建议使用 18 或更高版本（本项目 CI 使用 22）。"
    fi
}

# 确保 pnpm 可用（优先 corepack，其次 npm -g 安装）
ensure_pnpm() {
    if command -v pnpm >/dev/null 2>&1; then
        return 0
    fi
    if command -v corepack >/dev/null 2>&1; then
        info "未检测到 pnpm，尝试通过 corepack 启用..."
        corepack enable && corepack prepare pnpm@latest --activate && return 0
    fi
    info "未检测到 pnpm，通过 npm 全局安装..."
    npm install -g pnpm
}

# ---------- 构建 ----------
# 依赖安装 + Hexo 构建，产物位于 $SITE_ROOT/public
build_site() {
    cd "$SITE_ROOT"
    check_node || return 1
    ensure_pnpm || return 1

    info "安装依赖（pnpm install --frozen-lockfile）..."
    pnpm install --frozen-lockfile || pnpm install || return 1

    info "清理并生成静态文件（hexo clean && hexo generate）..."
    pnpm run clean  || return 1
    pnpm run build  || return 1

    [[ -f public/index.html ]] || die "构建完成但 public/index.html 不存在，构建失败。"
    info "构建完成：$(du -sh public | cut -f1) -> $SITE_ROOT/public"
}

# 交互式询问，带默认值；用法 ask "问题" "默认值" 变量名
ask() {
    local question="$1" default="$2" var="$3" answer
    if [[ -n "$default" ]]; then
        read -r -p "$question [${default}]: " answer
        answer="${answer:-$default}"
    else
        read -r -p "$question: " answer
    fi
    printf -v "$var" '%s' "$answer"
}
