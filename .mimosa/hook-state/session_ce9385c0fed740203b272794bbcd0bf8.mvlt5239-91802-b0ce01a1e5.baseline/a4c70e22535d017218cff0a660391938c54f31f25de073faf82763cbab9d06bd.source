#!/usr/bin/env bash
# deploy-vps.sh — 本地构建后，通过 rsync 同步到自己的服务器（Nginx 托管）。
# 用法:
#   ./scripts/deploy/deploy-vps.sh <user@server> [远程目录] [端口]
# 示例:
#   ./scripts/deploy/deploy-vps.sh root@example.com
#   ./scripts/deploy/deploy-vps.sh ubuntu@10.0.0.5 /var/www/blog 2222
# 环境变量方式也支持:
#   SSH_SERVER=root@example.com ./scripts/deploy/deploy-vps.sh
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"

SERVER="${1:-${SSH_SERVER:-}}"
REMOTE_PATH="${2:-${SSH_PATH:-/var/www/blog}}"
SSH_PORT="${3:-${SSH_PORT:-22}}"

[[ -n "$SERVER" ]] || die "用法: $0 <user@server> [远程目录] [端口]"
require_cmd rsync ssh || die "本脚本需要 rsync 和 ssh。"

build_site

info "同步 public/ -> $SERVER:$REMOTE_PATH (端口 $SSH_PORT)..."
ssh -p "$SSH_PORT" "$SERVER" "mkdir -p '$REMOTE_PATH'"
rsync -avz --delete -e "ssh -p $SSH_PORT" "$SITE_ROOT/public/" "$SERVER:$REMOTE_PATH/"

info "完成！"
cat <<'EOF'

如果服务器尚未配置 Nginx，可参考仓库中的示例配置:
  scripts/deploy/nginx-vps.conf
把 root 指向你的远程目录后，放到 /etc/nginx/sites-available/ 并启用。
提醒: 首次部署后记得 reload nginx。
EOF
