#!/usr/bin/env bash
# deploy-vercel.sh — 部署到 Vercel。
# 前置: npm / node；首次运行会引导浏览器登录 Vercel。
# 用法: ./scripts/deploy/deploy-vercel.sh
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"

VERCEL_JSON="$SITE_ROOT/vercel.json"

if [[ ! -f "$VERCEL_JSON" ]]; then
    info "首次运行，生成 vercel.json（指定 Hexo 构建命令与输出目录）..."
    cat > "$VERCEL_JSON" <<'EOF'
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hexo",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "hexo generate",
  "outputDirectory": "public"
}
EOF
    warn "vercel.json 已生成并会加入 git，方便下次部署与其他人使用。"
fi

# vercel CLI 通过 npx 调用，避免全局污染
cd "$SITE_ROOT"
require_cmd node || die "请先安装 Node.js (>=18)。"
command -v vercel >/dev/null 2>&1 || VERCEL_CMD="npx --yes vercel" || VERCEL_CMD="vercel"

info "登录状态检查..."
if ! $VERCEL_CMD whoami >/dev/null 2>&1; then
    info "未登录，打开浏览器完成 Vercel 登录..."
    $VERCEL_CMD login
fi

info "开始部署（首次会询问项目名，回车用默认即可）..."
$VERCEL_CMD --prod

info "完成！Vercel 会绑定一个 *.vercel.app 域名，也可在控制台绑定自定义域名。"
