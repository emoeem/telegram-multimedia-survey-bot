{
  "name": "telegram-multimedia-survey-bot",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:admin": "npm --prefix admin run build",
    "deploy": "npm run build:admin && wrangler deploy",
    "deploy:staging": "npm run build:admin && wrangler deploy -c wrangler.staging.toml",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "npm run build:admin && vite-node scripts/generate-report-fixtures.ts && playwright test",
    "test:visual:update": "npm run build:admin && vite-node scripts/generate-report-fixtures.ts && playwright test --update-snapshots",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "license-admin:setup": "node scripts/setup-license-admin.mjs",
    "license:issue": "node scripts/issue-license.mjs",
    "customer:deploy": "node scripts/deploy-customer.mjs",
    "customer:update": "node scripts/update-customers.mjs",
    "release": "node scripts/publish-release.mjs"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^1.1.0",
    "@cloudflare/workers-types": "^5.20260814.1",
    "@playwright/test": "^1.62.1",
    "@types/he": "^1.2.3",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "vite-node": "3.2.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.20.0"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "daisyui": "^5.7.20",
    "echarts": "^6.1.0",
    "fflate": "^0.8.3",
    "he": "^1.2.0",
    "parse5": "^8.0.1",
    "playwright": "^1.62.1"
  }
}
