BOT_TOKEN = "replace-with-telegram-bot-token"
WEBHOOK_SECRET = "replace-with-a-long-random-secret"
ADMIN_SESSION_SECRET = "replace-with-a-long-random-secret"
SURVEY_CODE_PEPPER = "replace-with-a-long-random-secret"
ADMIN_IDS = "123456789,987654321"

# 仅本地开发：设置后可用 x-telegram-user-id + x-dev-auth-secret 模拟登录管理后台。
# staging / 生产环境不要配置（后端只在 ENVIRONMENT=development 时接受该旁路）。
ADMIN_DEV_AUTH_SECRET = "replace-with-a-local-only-dev-secret"

# 厂商授权中心保持 disabled；交付给客户时改为 required。
LICENSE_ENFORCEMENT = "disabled"
LICENSE_SERVER_URL = "https://your-license-server.workers.dev"
LICENSE_KEY = "replace-with-customer-license-key"
INSTALLATION_ID = "replace-with-a-stable-random-installation-id"
LICENSE_GRACE_SECONDS = "86400"

# 只用于厂商授权中心的自动发证管理接口，客户部署不要配置。
LICENSE_ADMIN_TOKEN = "replace-with-a-long-vendor-only-secret"

# 部署角色：vendor = 授权中心（可签发授权、发布版本、发放体验账号）；
# customer = 已授权客户实例（以上能力全部关闭）。
# 客户部署由 scripts/deploy-customer.mjs 自动写入 customer；留空则回退为
# 「是否配置了 LICENSE_ADMIN_TOKEN」的旧判定。
DEPLOYMENT_ROLE = "vendor"

# 报告归档私人频道（Phase 5 使用）：把 Bot 添加为频道管理员后填入频道 ID
# （形如 -1001234567890）。
REPORT_CHANNEL_ID = ""

# 广场同步频道：发布到画廊的资料卡、树洞新投稿会自动转发到该频道。
# 同样把 Bot 添加为频道管理员后填入频道 ID；也可以在后台「设置」里配置。
PLAZA_CHANNEL_ID = ""
