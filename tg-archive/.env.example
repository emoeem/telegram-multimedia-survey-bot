# Get these from https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Optional phone (E.164, e.g. +8613800138000). If empty, login asks interactively.
TG_PHONE=

# Optional defaults (all can be overridden with CLI flags)
TG_ARCHIVE_DB=data/archive.sqlite3
TG_SESSION=data/archive.session
TG_MEDIA_CACHE=data/media

# Default channel to mirror into (private channel id like -1001234567890 or @username)
TG_ARCHIVE_CHANNEL=

# copy = repost with #hashtag metadata (default, works for single-channel organisation)
# forward = original message forwarded, highest fidelity but no added tags
WRITER_MODE=copy

# Protected chats: skip (default) | text_only (advanced) | allow_media (bypasses
# save restrictions by download+resend; HIGH RISK, use only where you are sure
# you are allowed to archive the content)
PROTECTED_POLICY=skip

# Seconds to wait between channel posts (be conservative to avoid flood waits)
POST_DELAY_SECONDS=0.8
