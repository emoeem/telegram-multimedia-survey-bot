{
  "$schema": "https://design-tokens.org/schema/v1",
  "meta": {
    "name": "telegram-multimedia-survey-bot design tokens",
    "source": "prototype-lab/assets/tokens.css（单一事实来源，本文件为其镜像）",
    "updated": "2026-11-22",
    "baseline": "提取自 admin/src/index.css（daisyUI foxgold/dark/light + --survey-* + --fx-*）与四张参考截图",
    "note": "生产落地时映射到 admin/src/index.css 的 data-theme 变量；不得引入高饱和紫/荧光色/无意义渐变"
  },
  "color": {
    "surface": {
      "page": { "dark": "#0f1118", "light": "#f2f3f7" },
      "panel": { "dark": "#161927", "light": "#ffffff" },
      "elevated": { "dark": "#1d2130", "light": "#ffffff" },
      "inset": { "dark": "#0c0e15", "light": "#eceef4" },
      "overlay": { "dark": "rgba(5,6,12,0.62)", "light": "rgba(24,28,50,0.45)" }
    },
    "text": {
      "primary": { "dark": "#e9ebf4", "light": "#22242e" },
      "secondary": { "dark": "#a3aabe", "light": "#5d6375" },
      "muted": { "dark": "#6f7689", "light": "#8b91a3" },
      "onBrand": { "dark": "#221507", "light": "#231506" }
    },
    "border": {
      "subtle": { "dark": "rgba(255,255,255,0.07)", "light": "rgba(22,25,45,0.09)" },
      "strong": { "dark": "rgba(255,255,255,0.14)", "light": "rgba(22,25,45,0.16)" }
    },
    "brand": {
      "primary": { "dark": "#e0a458", "light": "#cf8f3f" },
      "strong": { "dark": "#efb96f", "light": "#b97c2a" },
      "soft": { "dark": "rgba(224,164,88,0.14)", "light": "rgba(198,138,51,0.13)" },
      "softer": { "dark": "rgba(224,164,88,0.08)", "light": "rgba(198,138,51,0.08)" },
      "text": { "dark": "#e0a458", "light": "#9c6d20" }
    },
    "accent": {
      "primary": { "dark": "#8f9bff", "light": "#5a6cf0" },
      "soft": { "dark": "rgba(143,155,255,0.14)", "light": "rgba(90,108,240,0.12)" }
    },
    "status": {
      "success": { "dark": "#55c48b", "light": "#2e9e64" },
      "successSoft": { "dark": "rgba(85,196,139,0.14)", "light": "rgba(46,158,100,0.12)" },
      "warning": { "dark": "#e2a13d", "light": "#c78617" },
      "warningSoft": { "dark": "rgba(226,161,61,0.15)", "light": "rgba(199,134,23,0.13)" },
      "danger": { "dark": "#e5604f", "light": "#d24a3e" },
      "dangerSoft": { "dark": "rgba(229,96,79,0.15)", "light": "rgba(210,74,62,0.12)" },
      "info": { "dark": "#6aa5fa", "light": "#3d7ee8" },
      "infoSoft": { "dark": "rgba(106,165,250,0.14)", "light": "rgba(61,126,232,0.12)" }
    }
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px"
  },
  "radius": { "sm": "8px", "md": "12px", "lg": "16px", "xl": "20px" },
  "shadow": {
    "card": {
      "dark": "0 1px 2px rgba(0,0,0,0.28), 0 10px 28px rgba(0,0,0,0.28)",
      "light": "0 1px 2px rgba(24,28,50,0.06), 0 6px 20px rgba(24,28,50,0.07)"
    },
    "popover": {
      "dark": "0 6px 16px rgba(0,0,0,0.35), 0 20px 56px rgba(0,0,0,0.44)",
      "light": "0 6px 16px rgba(24,28,50,0.12), 0 20px 48px rgba(24,28,50,0.14)"
    },
    "modal": { "dark": "0 12px 40px rgba(0,0,0,0.5)", "light": "0 12px 40px rgba(24,28,50,0.2)" },
    "focusRing": { "dark": "0 0 0 3px rgba(224,164,88,0.28)", "light": "0 0 0 3px rgba(198,138,51,0.25)" }
  },
  "type": {
    "fontSans": "system-ui, -apple-system, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Noto Sans CJK SC', sans-serif",
    "fontMono": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace",
    "display": "26px / 650",
    "title": "19px / 600",
    "subtitle": "16px / 600",
    "body": "14px / 400",
    "bodyLg": "15px / 400",
    "caption": "12px / 400",
    "mono": "13px"
  },
  "control": { "sm": "32px", "md": "40px", "lg": "48px", "touchMin": "44px" },
  "layout": {
    "railW": "60px",
    "contentMax": "1120px",
    "contentPad": "24px",
    "topnavH": "56px",
    "breakpoints": {
      "mobile": "<640px",
      "tablet": "640-1023px",
      "desktop": ">=1024px",
      "wide": ">=1280px",
      "userNavSwitch": "900px（现有 BottomNav 为 1000px，落地时二选一对齐）"
    }
  }
}
