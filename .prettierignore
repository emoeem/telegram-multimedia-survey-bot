# cert/cert.html 是 scripts/build-cert-single.mjs 生成的内联单文件产物：
# CSS / JS / 词库全部内联成一行。它要进版本库（离线分发用），但按源码格式
# 检查没有意义——检查的其实是生成器的输出，而生成器每次都会重新覆盖它。
cert/cert.html

# SQL 迁移文件：prettier 没有 SQL parser。`prettier --check .` 的目录扫描
# 会静默跳过未知扩展名，但本地门禁把变更文件逐个显式传给 prettier，就会
# 报 "No parser could be inferred"（先例：94d3147 对 cert/cert.html 同款
# 失败的修法）。0098 还是对账生成产物（scripts/gen-reconcile-migration.mjs
# 输出，勿手工编辑），格式检查更无意义。
db/migrations/*.sql

# Wrangler 配置：prettier 没有 TOML parser（TOML 走插件，本仓库未装）。
# 目录扫描会静默跳过，但门禁逐个显式传变更文件时报 "No parser could be
# inferred"（同上先例）。P0 批次 G1 首次在门禁里触碰 wrangler*.toml 才暴露。
wrangler.toml
wrangler.staging.toml

# cert 目录的手工备份（.bak-<时间戳>）：双扩展名 .js.bak-… / .html.bak-…
# 推断不出 parser。目录扫描会静默跳过，但本地门禁把变更文件逐个显式传给
# prettier 时报 "No parser could be inferred"（先例：94d3147 / wrangler*.toml
# 同款修法）。备份是快照，格式检查无意义，永不应被 prettier 改写。
cert/*.bak-*

# 本文件自身无扩展名，同样没有 parser 可推断；显式传参时跳过自己
# （prettier 对被 ignore 的显式文件返回 0）。
.prettierignore
